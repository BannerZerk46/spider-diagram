 "nextId": 34,
 "bubbles": {
  "0": {
   "id": 0,
   "text": "1 · Start here",
   "x": 0,
   "y": 0,
   "parent": null,
   "kind": "main",
   "color": "#2b2d42",
   "order": 0,
   "notes": "<h2>Welcome to Spider Diagram</h2><p>This whole file is a tour, built with the app itself, so everything you see is something you can do.</p><ul><li>Bubbles with a <b>page icon</b> in the corner have notes: click the icon, or select the bubble and press <b>Ctrl+Enter</b>.</li><li>There are <b>four main ideas</b>. Start with this one, then go to <b>2</b> above it and carry on round <b>clockwise</b>.</li><li>Experiment freely: <b>Ctrl+Z</b> undoes anything, and <b>Fit</b> (Ctrl+0) shows everything again.</li></ul>"
  },
  "1": {
   "id": 1,
   "text": "Tab adds a branch",
   "x": -2.4927723245512605e-14,
   "y": -155.011331073069,
   "parent": 0,
   "color": "#e03131",
   "order": 0,
   "notes": "<ol><li>Click a bubble to select it.</li><li>Press <b>Tab</b> to add a branch coming off it, or <b>Enter</b> to add one next to it.</li><li>Type, then press <b>Enter</b> to finish. <b>Shift+Enter</b> starts a new line.</li></ol><p>To edit a bubble, select it and just start typing, or double-click it. <b>Esc</b> cancels.</p>"
  },
  "2": {
   "id": 2,
   "text": "Drag to move or re-attach",
   "x": 307.8661108197213,
   "y": 33.50093817993603,
   "parent": 0,
   "color": "#e8590c",
   "order": 1,
   "notes": "<ul><li><b>Drag</b> a bubble to move it; its branches come too. <b>Shift+drag</b> moves just that one.</li><li>Drop a bubble <b>onto</b> another to move it there.</li><li>With <b>Auto-tidy</b> on (Diagram menu), everything stays evenly spaced, clockwise in the order you made it, and dragging a bubble between two others changes its place.</li></ul>"
  },
  "3": {
   "id": 3,
   "text": "Fold away detail",
   "x": -25.907164634958683,
   "y": 162.30604455222607,
   "parent": 0,
   "color": "#f08c00",
   "order": 2,
   "notes": "<p>Fold branches you're not working on: click the <b>+N</b> badge, the small <b>−</b> on a selected bubble, or press <b>Ctrl+/</b>. Whole main ideas fold too, like number 4. <b>Diagram → Fold main ideas</b> folds them all into a neat honeycomb.</p>",
   "collapsed": true
  },
  "4": {
   "id": 4,
   "text": "Hidden until you unfold it",
   "x": -25.907164634958683,
   "y": 162.30604455222607,
   "parent": 3,
   "color": "#f08c00",
   "order": 0
  },
  "5": {
   "id": 5,
   "text": "Folded bubbles still export",
   "x": -25.907164634958683,
   "y": 162.30604455222607,
   "parent": 3,
   "color": "#f08c00",
   "order": 1
  },
  "6": {
   "id": 6,
   "text": "Keyboard shortcuts",
   "x": -284.1625195347556,
   "y": -14.189741336772562,
   "parent": 0,
   "color": "#66a80f",
   "order": 3,
   "notes": "<table><thead><tr><th>To…</th><th>Press</th></tr></thead><tbody><tr><td>Add a branch / a bubble next to it</td><td><b>Tab / Enter</b></td></tr><tr><td>Edit a bubble</td><td><b>Just type, double-click, F2 or Space</b></td></tr><tr><td>New line in a bubble</td><td><b>Shift+Enter</b></td></tr><tr><td>Delete</td><td><b>Delete</b></td></tr><tr><td>Move the selection</td><td><b>Arrow keys</b></td></tr><tr><td>Fold or unfold</td><td><b>Ctrl+/</b></td></tr><tr><td>Notes</td><td><b>Ctrl+Enter</b></td></tr><tr><td>Bold / italic</td><td><b>Ctrl+B / Ctrl+I</b></td></tr><tr><td>Bigger / smaller text</td><td><b>Ctrl+= / Ctrl+-</b></td></tr><tr><td>Undo / redo</td><td><b>Ctrl+Z / Ctrl+Shift+Z</b></td></tr><tr><td>Save / save as</td><td><b>Ctrl+S / Ctrl+Shift+S</b></td></tr><tr><td>Open</td><td><b>Ctrl+O</b></td></tr><tr><td>Export picture / document</td><td><b>Ctrl+E / Ctrl+Shift+E</b></td></tr><tr><td>Fit to screen</td><td><b>Ctrl+0</b></td></tr></tbody></table><p>The <b>Shortcuts</b> button in the bottom-left corner shows the main ones while you work.</p>"
  },
  "7": {
   "id": 7,
   "text": "2 · Make it look good",
   "x": 6.355666111260943e-14,
   "y": -1037.9590451199488,
   "parent": null,
   "kind": "main",
   "color": "#2b2d42",
   "order": 1,
   "notes": "<ul><li><b>Colour swatches</b> recolour a branch. Each main idea's branches go round the rainbow, and <b>Diagram → Rainbow colours</b> puts everything back in order.</li><li><b>Highlight sections</b>, bubble width and curved or straight lines are in the <b>Diagram</b> menu.</li><li>The sun/moon button switches light and dark mode.</li></ul>"
  },
