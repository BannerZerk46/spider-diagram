   "color": "#66a80f",
   "order": 3
  },
  "30": {
   "id": 30,
   "text": "I’m a free bubble",
   "x": 1230.205035982538,
   "y": -449.5292884710185,
   "parent": null,
   "kind": "free",
   "color": "#0c8599",
   "notes": "<p>Free bubbles don't belong to any main idea, and tidying leaves them where you put them. Add one with the <b>Free</b> button, or double-click empty space with nothing selected. Drop one onto a bubble to make it part of that branch.</p>"
  }
